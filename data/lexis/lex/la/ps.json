{"la:noun:psalmus":{"id":"la:noun:psalmus","lemma":"psalmus","pos":"noun","gloss":"psalm","src":"kaikki","senses":["psalm"],"html":"<b>psalmus</b>, <i>i</i>, <i>m.</i>, = <span class=\"gr\">ψαλμός</span>, i. q. psalma, <div class=\"sense\"><i>a psalm</i> (eccl. Lat.; cf.: <span class=\"note\"><i>carmen, hymnus),</i></span>; ; ; .—Esp., <i>the Psalms of David</i>, ; et saep.</div>","inflection":"i, m.","dict":"kaikki"},"la:noun:psalterium":{"id":"la:noun:psalterium","lemma":"psalterium","pos":"noun","gloss":"lute or psaltery","src":"kaikki","senses":["lute or psaltery"],"html":"<b>psaltērĭum</b>, <i>ĭi</i>, <i>n.</i>, = <span class=\"gr\">ψαλτήριον</span> (e scanned short, Ven. Fort. 2, 19, 43). <div class=\"sense\"><i>A stringed instrument of the lute kind</i>, <i>a psaltery</i>, Varr. ap. ; ; ; ; ; ; ; ; ; .—</div><div class=\"sense\">Transf., <i>a song sung to the psaltery.</i></div><div><i>A satire</i>, Varr. ap. ; .—</div><div><i>The songs of David</i>, <i>the Psalms</i>, ; et saep.</div>","inflection":"ĭi, n.","dict":"kaikki"},"la:noun:pseudapostolus":{"id":"la:noun:pseudapostolus","lemma":"pseudapostolus","pos":"noun","gloss":"false apostle","src":"kaikki","senses":["false apostle"],"html":"<b>pseudăpostŏlus</b>, <i>i</i>, <i>m.</i>, = <span class=\"gr\">ψευδαπόστολος</span>, <div class=\"sense\"><i>a false apostle</i>, ; ; .</div>","inflection":"i, m.","dict":"kaikki"},"la:noun:psaltria":{"id":"la:noun:psaltria","lemma":"psaltria","pos":"noun","gloss":"lutist, cithara player (female)","src":"kaikki","senses":["lutist, cithara player (female)"],"html":"<b>psaltrĭa</b>, <i>ae</i>, <i>f.</i>, = <span class=\"gr\">ψάλτρια</span>, <div class=\"sense\"><i>a female player on the cithara</i>, <i>a lutist</i>, ; ; et saep.; ; id. Fragm. ap. ; ; ; .</div>","inflection":"ae, f.","dict":"kaikki"},"la:other:Psalmi":{"id":"la:other:Psalmi","lemma":"Psalmi","pos":"other","gloss":"Psalms","src":"kaikki","senses":["Psalms"],"dict":"kaikki"},"la:verb:psallens":{"id":"la:verb:psallens","lemma":"psallens","pos":"verb","gloss":"(verb, no gloss found)"},"la:noun:pseudopropheta":{"id":"la:noun:pseudopropheta","lemma":"pseudopropheta","pos":"noun","gloss":"a false prophet","src":"kaikki","senses":["a false prophet"],"html":"<b>pseudŏprŏphēta</b>, <i>ae</i>, <i>m.</i>, = <span class=\"gr\">ψευδοπροφήτης</span>, <div class=\"sense\"><i>a false prophet</i>, ; ; .</div>","inflection":"ae, m.","dict":"kaikki"},"la:verb:psallo":{"id":"la:verb:psallo","lemma":"psallo","pos":"verb","gloss":"to play or sing to the cithara","src":"kaikki","senses":["to play or sing to the cithara","to sing or play a tune","to sing psalms"],"html":"<b>psallo</b>, <i>i, 3</i>, <i>v. n.</i>, = <span class=\"gr\">ψάλλω</span>. <div class=\"sense\"> In gen., <i>to play upon a stringed instrument;</i> esp., <i>to play upon the cithara</i>, <i>to sing to the cithara</i>: <span class=\"note\"><i>psallere saltare elegantius,</i></span> (but in the correct read. is saltare et cantare; <span class=\"note\"><i>v. Halm ad h. l.): qui canerent voce et qui psallerent,</i></span>; cf.: <span class=\"note\"><i>cantare et psallere jucunde,</i></span>; : <span class=\"note\"><i>docta psallere Chia,</i></span>; . —Of singing to the cithara: Calliope princeps sapienti psallerat ore, Caesius Bassus ap. P.; ; Prud. <span class=\"gr\">στεφ.</span> 10, 837.—<i>Impers.</i>: <span class=\"note\"><i>in caelo cantatur et psallitur,</i></span>.—</div><div class=\"sense\"> In partic., in eccl. Lat., <i>to sing the Psalms of David</i>, ; ; ; et saep.</div>","inflection":"i, 3, v. n.","dict":"kaikki"},"la:noun:psalmista":{"id":"la:noun:psalmista","lemma":"psalmista","pos":"noun","gloss":"psalmist","src":"kaikki","senses":["psalmist"],"html":"<b>psalmista</b>, <i>ae</i>, <i>m.</i>, = <span class=\"gr\">ψαλμιστής</span>, <div class=\"sense\"><i>a composer</i> or <i>singer of psalms</i>, <i>a psalm-writer</i>, <i>psalm-singer</i>, <i>psalmist</i> (eccl. Lat.), ; ; .</div>","inflection":"ae, m.","dict":"kaikki"},"la:noun:psychomantium":{"id":"la:noun:psychomantium","lemma":"psychomantium","pos":"noun","gloss":"a place for necromancy, for consulting with the spirits of the dead","src":"kaikki","senses":["a place for necromancy, for consulting with the spirits of the dead"],"html":"<b>psȳchŏmantīum</b> or <b>-ēum</b>, <i>i</i>, <i>n.</i>, = <span class=\"gr\">ψυχομαντεῖον</span>, <div class=\"sense\"><i>a place where the spirits of the dead were interrogated</i>, <i>a place of</i><p><i>necromancy</i>, .—<i>Plur.</i>, .</p></div>","inflection":"i, n.","dict":"kaikki"},"la:name:Pseudolo":{"id":"la:name:Pseudolo","lemma":"Pseudolo","pos":"name","gloss":"proper name","src":"name"},"la:noun:pseudothyrum":{"id":"la:noun:pseudothyrum","lemma":"pseudothyrum","pos":"noun","gloss":"a secret door; back door; private entrance; postern gate","src":"kaikki","senses":["a secret door; back door; private entrance; postern gate","a secret manner"],"html":"<b>pseudŏthўrum</b>, <i>i</i>, <i>n.</i>, = <span class=\"gr\">ψευδόθυρον</span>. <div class=\"sense\">Lit., <i>a backdoor</i>, <i>private entrance</i>, <i>postern-gate</i>: <span class=\"note\"><i>palatii,</i></span>; —</div><div class=\"sense\">Trop., <i>a secret manner</i>: <span class=\"note\"><i>(nummi) per pseudothyrum revertantur,</i></span>: <span class=\"note\"><i>non janua receptis, sed pseudothyro intromissis voluptatibus,</i></span>.</div>","inflection":"i, n.","dict":"kaikki"},"la:noun:PS":{"id":"la:noun:PS","lemma":"PS","pos":"noun","gloss":"initialism of post scriptum, postscriptum, postscript","src":"kaikki","senses":["initialism of post scriptum, postscriptum, postscript","abbreviation of pustulatum or pusulatum"],"dict":"kaikki"},"la:name:PSQ":{"id":"la:name:PSQ","lemma":"PSQ","pos":"name","gloss":"proper name","src":"name"},"la:name:PS×Pv":{"id":"la:name:PS×Pv","lemma":"PS×Pv","pos":"name","gloss":"proper name","src":"name"},"la:name:PS×QR":{"id":"la:name:PS×QR","lemma":"PS×QR","pos":"name","gloss":"proper name","src